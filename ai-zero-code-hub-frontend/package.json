{
  "name": "ai-zero-code-hub-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "openapi:generate": "openapi --input ./openapi.json --output src/api/generated --client axios --useOptions --exportCore true --exportServices true --exportModels true",
    "openapi:download": "node ./scripts/openapi-download.mjs",
    "openapi:generate:url": "npm run openapi:download && npm run openapi:generate"
  },
  "dependencies": {
    "ant-design-vue": "^4.2.6",
    "axios": "^1.13.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.10.9",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "~10.7.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "openapi-typescript-codegen": "^0.30.0",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "vite": "^6.3.0",
    "vue-tsc": "^3.2.2"
  },
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  }
}
